+  for (const status of expectedHealthFaults) assert.ok(responses.some(response => response.path === '/health' && response.status === status), `transient health failure ${status} was not observed`)
+  for (const status of [502, 503]) assert.ok(responses.some(response => response.path === '/screen' && response.status === status), `transient screen failure ${status} was not observed`)
