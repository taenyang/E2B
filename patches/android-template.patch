+#!/usr/bin/env bash
+set -euo pipefail
+
+systemctl start docker
+mkdir -p /dev/binderfs
+mountpoint -q /dev/binderfs || mount -t binder binder /dev/binderfs
+docker start android
+adb connect 127.0.0.1:5555 >/dev/null 2>&1 || true
+systemctl start android-screen-bridge
+for attempt in $(seq 1 300); do
+  if curl --fail --max-time 10 http://127.0.0.1:8080/health >/dev/null; then
+    exec sleep infinity
+  fi
+  adb connect 127.0.0.1:5555 >/dev/null 2>&1 || true
+  sleep 1
+done
+printf '%s\n' 'ANDROID_STARTUP_FAILED'
+printf '%s\n' 'ADB_DEVICES'
+timeout 10s adb devices || true
+printf '%s\n' 'ADB_STATE'
+timeout 10s adb -s 127.0.0.1:5555 get-state || true
+printf '%s\n' 'ANDROID_BOOT_COMPLETED'
+timeout 10s adb -s 127.0.0.1:5555 shell getprop sys.boot_completed || true
+printf '%s\n' 'DOCKER_CONTAINER_STATE'
+timeout 10s docker ps -a --filter name=^/android$ --format '{{.Names}} {{.Status}} {{.State}}' || true
+printf '%s\n' 'DOCKER_CONTAINER_INSPECT'
+timeout 10s docker inspect android || true
+printf '%s\n' 'DOCKER_LOG_TAIL'
+timeout 15s docker logs --tail 100 android || true
+printf '%s\n' 'BRIDGE_SERVICE_STATE'
+timeout 10s systemctl status android-screen-bridge --no-pager || true
+timeout 10s systemctl show android-screen-bridge -p MainPID -p ActiveState -p SubState || true
+printf '%s\n' 'FINAL_HEALTH_RESPONSE'
+timeout 15s curl -i --max-time 10 http://127.0.0.1:8080/health || true
+exit 1
