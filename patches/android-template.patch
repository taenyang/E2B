+#!/usr/bin/env python3
+"""Verify packaged kernel inputs, resolved configuration, and the Firecracker ELF."""
+import argparse
+import datetime
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+INPUTS = Path(__file__).resolve().parent
+ROOT = INPUTS.parent
+SOURCE = ROOT / 'kernel-source'
+BUILD = ROOT / 'kernel-build'
+OUTPUT = ROOT / 'kernel-output'
+ARCHIVE_NAME = 'linux-c2b7f640ec01cb093c6ba9e08b7ebcb400741bb4.tar.gz'
+CONFIG_NAME = '6.1.158-android.config'
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def input_path(name, archive):
+    return archive if name == ARCHIVE_NAME and archive else INPUTS / name
+
+
+def verify_inputs(archive, require_archive):
+    manifest = json.loads((INPUTS / 'source-provenance.json').read_text())
+    expected = manifest['input_sha256']
+    required_inputs = {
+        ARCHIVE_NAME, CONFIG_NAME, 'build-kernel.sh', 'verify-kernel.py',
+        'upstream-tags.txt', 'upstream-commit.json',
+        '0001-virtio_balloon-Support-wait-on-ACK-for-hinting.patch',
+        '0001-memfd-answer-ashmem-ioctls.patch',
+    }
+    if set(expected) != required_inputs:
+        raise AssertionError('input hash manifest must include exactly all pinned inputs and scripts')
+    if expected[ARCHIVE_NAME] != '1a604f792a1f734537265d634c7ec2c972baaa8a65a835958272620799ab45c5':
+        raise AssertionError(f'{ARCHIVE_NAME}: pinned archive hash metadata changed')
+    if not (INPUTS / CONFIG_NAME).is_file():
+        raise AssertionError(f'missing required supplied config: {INPUTS / CONFIG_NAME}')
+
+    for name, digest in expected.items():
+        path = input_path(name, archive)
+        if not path.is_file():
+            if name == ARCHIVE_NAME and not require_archive:
+                print(f'ARCHIVE ABSENT: {path} (input-only verification did not compile)')
+                continue
+            raise AssertionError(f'missing input: {path}')
+        actual = sha256(path)
+        if actual != digest:
+            raise AssertionError(f'{name}: expected {digest}, got {actual}')
+    required_config((INPUTS / CONFIG_NAME).read_text())
+    print('PASS: packaged input hashes and required supplied config options verified')
+
+
+def required_config(config):
+    required = '''X86_64 ANDROID_BINDER_IPC ANDROID_BINDERFS MEMFD_CREATE
+MEMFD_ASHMEM_COMPAT SHMEM TMPFS TMPFS_XATTR DMABUF_HEAPS DMABUF_HEAPS_SYSTEM
+PSI IKCONFIG IKCONFIG_PROC CGROUPS MEMCG CGROUP_PIDS CGROUP_DEVICE NAMESPACES
+UTS_NS IPC_NS USER_NS PID_NS NET_NS SECCOMP SECCOMP_FILTER VIRTIO_MMIO
+VIRTIO_BLK VIRTIO_NET VIRTIO_BALLOON VIRTIO_VSOCKETS EXT4_FS OVERLAY_FS
+DEVTMPFS DEVTMPFS_MOUNT INET IPV6 BPF_SYSCALL BPF_JIT'''.split()
+    for name in required:
+        assert f'CONFIG_{name}=y\n' in config, name
+    assert '# CONFIG_PSI_DEFAULT_DISABLED is not set\n' in config
+    assert 'CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"\n' in config
+    assert 'CONFIG_BUILD_SALT="6.1.158-android-amzn2023.x86_64"\n' in config
+    return required
+
+
+def verify_config():
+    config = (BUILD / '.config').read_text()
+    required = required_config(config)
+    original = (INPUTS / CONFIG_NAME).read_text()
+    (OUTPUT / 'config-resolution.diff').write_text(''.join(difflib.unified_diff(
+        original.splitlines(True), config.splitlines(True),
+        fromfile='supplied-android.config', tofile='resolved-kernel.config')))
+    print(f'PASS: {len(required)} required built-in options, Binder devices, PSI default and build salt')
+
+
+def elf_segments(path):
+    data = path.read_bytes()
+    assert data[:6] == b'\x7fELF\x02\x01', 'expected little-endian ELF64'
+    header = struct.unpack_from('<HHIQQQIHHHHHH', data, 16)
+    assert header[0] == 2 and header[1] == 62, 'expected x86-64 executable'
+    segments = []
+    for i in range(header[9]):
+        p = struct.unpack_from('<IIQQQQQQ', data, header[4] + i * header[8])
+        if p[0] == 1:
+            assert p[5] <= p[6] and p[2] + p[5] <= len(data)
+            segments.append((p[1], p[3], p[4], p[5], p[6], p[7],
+                             hashlib.sha256(data[p[2]:p[2] + p[5]]).hexdigest()))
+    assert segments, 'no loadable segments'
+    assert any(s[0] & 1 and (s[1] <= header[3] < s[1] + s[4] or
+                            s[2] <= header[3] < s[2] + s[4]) for s in segments), 'entry outside executable segments'
+    return header[3], segments
+
+
+def verify_build():
+    verify_config()
+    artifact = OUTPUT / 'vmlinux.bin'
+    entry, segments = elf_segments(artifact)
+    assert (entry, segments) == elf_segments(BUILD / 'vmlinux'), 'stripping changed boot segments'
+    embedded = subprocess.check_output(['bash', str(SOURCE / 'scripts/extract-ikconfig'), str(artifact)])
+    assert embedded == (BUILD / '.config').read_bytes(), 'embedded config mismatch'
+    (OUTPUT / 'embedded.config').write_bytes(embedded)
+    symbols = {line.split()[-1] for line in (BUILD / 'System.map').read_text().splitlines()}
+    for symbol in ('binder_ioctl', 'memfd_ashmem_compat_ioctl', 'shmem_ioctl'):
+        assert symbol in symbols, symbol
+    release = (BUILD / 'include/config/kernel.release').read_text().strip()
+    assert release == '6.1.158', release
+    header_text = subprocess.check_output(['readelf', '-h', '-l', str(artifact)], text=True)
+    (OUTPUT / 'elf-verification.txt').write_text(header_text)
+    provenance = json.loads((INPUTS / 'source-provenance.json').read_text())
+    provenance.update({
+        'verified_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+        'kernel_release': release,
+        'architecture': 'amd64 (x86_64 ELF64 little-endian executable)',
+        'compiler': subprocess.check_output(['gcc', '--version'], text=True).splitlines()[0],
+        'linker': subprocess.check_output(['ld', '--version'], text=True).splitlines()[0],
+        'pahole': subprocess.check_output(['pahole', '--version'], text=True).strip(),
+        'build_command': 'make -C ../kernel-source O=../kernel-build ARCH=x86_64 -j8 vmlinux',
+        'build_environment': {'KBUILD_BUILD_USER': 'android-template', 'KBUILD_BUILD_HOST': 'android-template',
+                              'KBUILD_BUILD_TIMESTAMP': 'Fri Nov 6 18:00:00 UTC 2026', 'KBUILD_BUILD_VERSION': '1'},
+        'artifact_size_bytes': artifact.stat().st_size,
+        'elf_entry': hex(entry), 'loadable_segments': len(segments),
+        'verification': ['required config options built in', 'embedded config equals resolved config',
+                         'binder and memfd ashmem ioctl symbols present',
+                         'ELF64 AMD64 executable', 'stripping preserves all PT_LOAD segment contents'],
+        'runtime_boot_test': 'Not performed; this task builds and statically verifies the guest kernel.',
+        'compatibility_limit': 'Supplied ashmem ioctl shim supports 64-bit callers only; target redroid16 64only.',
+    })
+    files = ['vmlinux.bin', 'vmlinux.debug', 'kernel.config', 'embedded.config', 'System.map']
+    provenance['artifact_sha256'] = {name: sha256(OUTPUT / name) for name in files}
+    (OUTPUT / 'provenance.json').write_text(json.dumps(provenance, indent=2) + '\n')
+    (OUTPUT / 'SHA256SUMS').write_text(''.join(f'{digest}  {name}\n' for name, digest in provenance['artifact_sha256'].items()))
+    (OUTPUT / 'vmlinux.bin.sha256').write_text(f"{provenance['artifact_sha256']['vmlinux.bin']}  vmlinux.bin\n")
+    print(f'PASS: ELF64 AMD64, entry {entry:#x}, {len(segments)} unchanged loadable segments, embedded config, Binder and memfd shim symbols')
+    print(f"SHA256 {provenance['artifact_sha256']['vmlinux.bin']}  {artifact}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--inputs-only', action='store_true', help='verify packaged files without reading build outputs')
+    parser.add_argument('--config-only', action='store_true', help='verify the resolved build configuration')
+    parser.add_argument('--require-archive', action='store_true', help='fail if the pinned source archive is absent')
+    parser.add_argument('--archive', type=Path, help=f'path to the separately supplied {ARCHIVE_NAME}')
+    args = parser.parse_args()
+    if args.inputs_only and args.config_only:
+        parser.error('--inputs-only and --config-only are mutually exclusive')
+    archive = args.archive.resolve() if args.archive else None
+    if archive and archive.name != ARCHIVE_NAME:
+        parser.error(f'archive must be named {ARCHIVE_NAME}')
+    verify_inputs(archive, args.require_archive or bool(archive))
+    if args.inputs_only:
+        return
+    if args.config_only:
+        verify_config()
+        return
+    verify_build()
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (AssertionError, FileNotFoundError, OSError) as error:
+        print(f'FAIL: {error}', file=sys.stderr)
+        raise SystemExit(1)
