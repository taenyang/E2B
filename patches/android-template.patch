@@ -0,0 +1,216 @@
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import assert from 'node:assert/strict';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+const oldText = 'label:"Templates",href:s.OI.TEMPLATES,icon:r.Ik,activeMatch:"/templates/**"}';
+const androidNav = 'label:"Android 屏幕",href:"/android-screen.html",icon:r.Ik';
+const newText = `${oldText},{${androidNav}}`;
+const createAction = 'href:"/docs/quickstart",target:"_blank",rel:"noopener"';
+const newCreateAction = 'href:"/sandbox-create.html"';
+const serverOldText = oldText.replaceAll('s.OI.', 'e.OI.').replaceAll('r.Ik', 'd.Ik');
+const serverNewText = newText.replaceAll('s.OI.', 'e.OI.').replaceAll('r.Ik', 'd.Ik');
+const terminalOld = 'let a;a=d?(await S.ak.connect(d,{...i,timeoutMs:18e5,requestTimeoutMs:f})).sandboxId:(await S.ak.create(h,{...i,timeoutMs:18e5,requestTimeoutMs:f,lifecycle:{onTimeout:"pause",autoResume:!0},metadata:{source:"dashboard-terminal",template:h}})).sandboxId;let b=await S.ak.getFullInfo(a,{...i,requestTimeoutMs:f});return{sandboxId:a,sandboxDomain:b.sandboxDomain,envdVersion:b.envdVersion,envdAccessToken:b.envdAccessToken}';
+const terminalNew = 'let connection=d?await S.ak.connect(d,{...i,timeoutMs:18e5,requestTimeoutMs:f}):await S.ak.create(h,{...i,timeoutMs:18e5,requestTimeoutMs:f,...h==="android-16"?{network:{...i.network,allowPublicTraffic:!1}}:{},lifecycle:{onTimeout:"pause",autoResume:!0},metadata:{source:"dashboard-terminal",template:h}});let a=connection.sandboxId,b=await S.ak.getFullInfo(a,{...i,requestTimeoutMs:f});return{sandboxId:a,sandboxDomain:b.sandboxDomain,envdVersion:b.envdVersion,envdAccessToken:b.envdAccessToken,trafficAccessToken:connection.trafficAccessToken}';
+
+function renderPage(html, value) {
+  if (typeof value !== 'string' || !value) throw new Error('PUBLIC_SANDBOX_URL is required');
+  let url;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error('PUBLIC_SANDBOX_URL must be a valid HTTP(S) URL');
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.search || url.hash) {
+    throw new Error('PUBLIC_SANDBOX_URL must be an HTTP(S) base URL without credentials, query or fragment');
+  }
+  const marker = '__PUBLIC_SANDBOX_URL_JSON__';
+  if (html.split(marker).length !== 2) throw new Error('Android page configuration sentinel was not found exactly once');
+  const encoded = JSON.stringify(url.href.replace(/\/+$/, '')).replace(/</g, '\\u003c');
+  return html.replace(marker, () => encoded);
+}
+
+function patchDashboard(appRoot, publicSandboxUrl) {
+  const root = path.join(appRoot, '.next');
+  const page = path.join(appRoot, 'public', 'android-screen.html');
+  const renderedPage = renderPage(fs.readFileSync(page, 'utf8'), publicSandboxUrl);
+  let serverNavChanged = 0;
+  let changed = 0;
+  let androidSentinels = 0;
+  let terminalChanged = 0;
+  let createChanged = 0;
+  const changedAssets = new Set();
+
+  function visit(dir) {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      const file = path.join(dir, entry.name);
+      if (entry.isDirectory()) {
+        visit(file);
+        continue;
+      }
+      if (!entry.isFile() || !file.endsWith('.js')) continue;
+      const source = fs.readFileSync(file, 'utf8');
+      const serverMatches = source.split(serverOldText).length - 1;
+      const terminalMatches = source.split(terminalOld).length - 1;
+      const matches = source.split(oldText).length - 1;
+      const createMatches = source.split(createAction).length - 1;
+      let patched = source.split(createAction).join(newCreateAction);
+      createChanged += createMatches;
+      if (serverMatches) {
+        patched = patched.split(serverOldText).join(serverNewText);
+        serverNavChanged += serverMatches;
+      }
+      if (terminalMatches) {
+        patched = patched.split(terminalOld).join(terminalNew);
+        terminalChanged += terminalMatches;
+      }
+      if (matches) {
+        patched = patched.split(oldText).join(newText);
+        changed += matches;
+        androidSentinels += patched.split(androidNav).length - 1;
+      }
+      if (patched !== source) fs.writeFileSync(file, patched);
+      if ((serverMatches || terminalMatches || matches || createMatches) && file.startsWith(path.join(root, 'static') + path.sep)) {
+        changedAssets.add(file);
+      }
+    }
+  }
+
+  visit(root);
+  if (changed !== 1 || serverNavChanged !== 1) {
+    throw new Error(`Expected one matching server/client Android navigation definition, found ${serverNavChanged}/${changed}`);
+  }
+  if (androidSentinels !== changed) throw new Error('Android navigation sentinel count does not match patched navigation');
+  if (terminalChanged !== 1) throw new Error(`Expected one sandbox.openTerminal implementation, found ${terminalChanged}`);
+  if (createChanged !== 2) throw new Error(`Expected two sandbox creation links, found ${createChanged}`);
+
+  const renamedAssets = new Map();
+  for (const file of changedAssets) {
+    const hash = crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex').slice(0, 16);
+    const name = path.basename(file);
+    const renamed = name.replace(/-[a-f0-9]+\.js$/, `-${hash}.js`);
+    if (renamed === name) throw new Error(`Cannot version patched asset ${name}`);
+    fs.renameSync(file, path.join(path.dirname(file), renamed));
+    renamedAssets.set(name, renamed);
+  }
+
+  function updateReferences(dir) {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      const file = path.join(dir, entry.name);
+      if (entry.isDirectory()) updateReferences(file);
+      else if (entry.isFile() && /\.(js|json|html|rsc)$/.test(file)) {
+        const source = fs.readFileSync(file, 'utf8');
+        let patched = source;
+        for (const [oldName, newName] of renamedAssets) patched = patched.split(oldName).join(newName);
+        if (patched !== source) fs.writeFileSync(file, patched);
+      }
+    }
+  }
+
+  updateReferences(root);
+  fs.writeFileSync(page, renderedPage);
+  return { changed, serverNavChanged, terminalChanged, createChanged, renamedAssets };
+}
+
+async function selfTest() {
+  const html = fs.readFileSync(path.join(__dirname, 'android-screen.html'), 'utf8');
+  assert.match(html, /SDK/);
+  assert.match(html, /allowPublicTraffic/);
+  assert.match(html, /后端代理/);
+  assert.match(html, /不自动创建沙箱/);
+  assert.match(html, /sandbox-create\.html/);
+  assert.doesNotMatch(html, /e2b-tutorial\.html|localStorage|sessionStorage/);
+  assert.match(html, /event\.origin !== location\.origin/);
+  assert.match(html, /e2b-traffic-access-token/);
+  assert.match(html, /credentials: 'omit'/);
+  assert.match(html, /error\.transient === true/);
+  assert.match(html, /error\.name === 'AbortError'/);
+  assert.doesNotMatch(html, /error\.name === 'TypeError'/);
+  assert.doesNotMatch(html, /return !error\.status/);
+
+  const rendered = renderPage(html, 'http://example.test:8009/');
+  assert.ok(rendered.includes('const proxyBase = "http://example.test:8009";'));
+  assert.ok(!rendered.includes('__PUBLIC_SANDBOX_URL_JSON__'));
+  for (const value of [undefined, '', 'not a URL', 'file:///tmp/x', 'https://user:password@example.test', 'https://example.test/?token=x', 'https://example.test/#x']) {
+    assert.throws(() => renderPage(html, value));
+  }
+  assert.throws(() => renderPage('no marker', 'https://example.test'));
+  assert.throws(() => renderPage(html + html, 'https://example.test'));
+
+  for (const extraNav of ['', ',{label:"Existing page",href:"/existing.html"}']) {
+    const fixture = fs.mkdtempSync(path.join(os.tmpdir(), 'android-dashboard-patch-'));
+    try {
+      const fixtureRoot = path.join(fixture, '.next');
+      const fixtureStatic = path.join(fixtureRoot, 'static');
+      fs.mkdirSync(fixtureStatic, { recursive: true });
+      fs.mkdirSync(path.join(fixture, 'public'), { recursive: true });
+      const asset = 'chunk-abcdef123456.js';
+      const fixtureSource = nav => `const menu=[{${nav}${extraNav}];const create={${createAction}};`;
+      fs.writeFileSync(path.join(fixture, 'public', 'android-screen.html'), html);
+      fs.writeFileSync(path.join(fixtureRoot, 'server.js'), fixtureSource(serverOldText));
+      fs.writeFileSync(path.join(fixtureStatic, asset), `${fixtureSource(oldText)}\nasync function terminal(){${terminalOld}}`);
+      fs.writeFileSync(path.join(fixtureRoot, 'build-manifest.json'), asset);
+      const result = patchDashboard(fixture, 'https://example.test:8009/');
+      assert.equal(result.changed, 1);
+      assert.equal(result.serverNavChanged, 1);
+      assert.equal(result.terminalChanged, 1);
+      assert.equal(result.createChanged, 2);
+      assert.equal(result.renamedAssets.size, 1);
+      assert.ok(!fs.existsSync(path.join(fixtureStatic, asset)));
+      for (const file of [path.join(fixtureRoot, 'server.js'), path.join(fixtureStatic, result.renamedAssets.get(asset))]) {
+        const source = fs.readFileSync(file, 'utf8');
+        const menu = new Function('s', 'r', 'e', 'd', source + ';return menu;')({ OI: {} }, {}, { OI: {} }, {});
+        assert.deepEqual(menu.map(item => item.label), ['Templates', 'Android 屏幕', ...(extraNav ? ['Existing page'] : [])]);
+        assert.ok(source.includes(newCreateAction));
+        assert.ok(!source.includes(createAction));
+      }
+      assert.equal(fs.readFileSync(path.join(fixtureRoot, 'build-manifest.json'), 'utf8'), result.renamedAssets.get(asset));
+      assert.ok(fs.readFileSync(path.join(fixture, 'public', 'android-screen.html'), 'utf8').includes('const proxyBase = "https://example.test:8009";'));
+    } finally {
+      fs.rmSync(fixture, { recursive: true, force: true });
+    }
+  }
+
+  const runTerminal = new (Object.getPrototypeOf(async function () {}).constructor)('S', 'd', 'i', 'h', 'f', terminalNew);
+  let createOptions;
+  let connectedId;
+  const sdk = { ak: {
+    create: async (template, options) => {
+      assert.equal(template, 'android-16');
+      createOptions = options;
+      return { sandboxId: 'android-id', trafficAccessToken: 'created-token' };
+    },
+    connect: async id => {
+      connectedId = id;
+      return { sandboxId: id, trafficAccessToken: 'reconnected-token' };
+    },
+    getFullInfo: async () => ({ sandboxDomain: 'android.test', envdVersion: 'v1', envdAccessToken: 'envd-token' })
+  } };
+  const created = await runTerminal(sdk, undefined, { network: { allowPrivateTraffic: true } }, 'android-16');
+  assert.equal(createOptions.network.allowPrivateTraffic, true);
+  assert.equal(createOptions.network.allowPublicTraffic, false);
+  assert.equal(created.trafficAccessToken, 'created-token');
+  const reconnected = await runTerminal(sdk, 'android-id', {}, 'android-16');
+  assert.equal(connectedId, 'android-id');
+  assert.equal(reconnected.trafficAccessToken, 'reconnected-token');
+  await runTerminal({ ak: { ...sdk.ak, create: async (template, options) => {
+    assert.equal(template, 'base');
+    assert.deepEqual(options.network, { allowPublicTraffic: true });
+    return { sandboxId: 'base-id' };
+  } } }, undefined, { network: { allowPublicTraffic: true } }, 'base');
+  console.log('Dashboard layering, creation links, base/private Android creation, token forwarding and recovery checks passed');
+}
+
+if (process.argv.includes('--self-test')) {
+  selfTest().catch(error => {
+    console.error(error);
+    process.exitCode = 1;
+  });
+} else {
+  patchDashboard('/app', process.env.PUBLIC_SANDBOX_URL);
+  console.log('Added Android navigation, enabled private Android creation, forwarded traffic credentials, and versioned patched browser assets');
+}
