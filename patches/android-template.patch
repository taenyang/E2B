+++ b/templates/android/sandbox-create.html
@@ -0,0 +1,130 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="referrer" content="no-referrer">
+  <title>Create a Sandbox · E2B Embed</title>
+  <style>
+    :root { color-scheme: light; font: 16px/1.5 system-ui, sans-serif; color: #172033; background: #f5f7fb; }
+    * { box-sizing: border-box; }
+    main { max-width: 640px; margin: auto; padding: 24px; }
+    a { color: #174eb5; }
+    form, .status { margin-top: 20px; padding: 20px; background: #fff; border: 1px solid #dfe4ee; border-radius: 12px; }
+    label { display: block; margin-bottom: 8px; font-weight: 600; }
+    select, button { min-height: 44px; padding: 8px 12px; font: inherit; border: 1px solid #65738a; border-radius: 6px; }
+    select { width: 100%; background: #fff; color: #172033; }
+    button { margin-top: 16px; cursor: pointer; background: #edf3ff; color: #173b8f; }
+    button:disabled, select:disabled { cursor: default; opacity: .55; }
+    :focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
+    [hidden] { display: none; }
+  </style>
+</head>
+<body>
+<main>
+  <a href="/sandboxes">Back to Sandboxes</a>
+  <h1>Create a Sandbox</h1>
+  <p>Choose a template to create a sandbox. Android sandboxes require an access token; use “Open Android screen” after creation to connect automatically.</p>
+  <form id="create-form">
+    <label for="template">Template</label>
+    <select id="template" name="template">
+      <option value="base">base</option>
+      <option value="android-16">android-16</option>
+    </select>
+    <button id="submit" type="submit">Create Sandbox</button>
+  </form>
+  <p id="loading" class="status" role="status" aria-live="polite" hidden>Creating sandbox…</p>
+  <p id="error" class="status" role="alert" hidden></p>
+  <p id="result" class="status" role="status" aria-live="polite" hidden></p>
+  <button id="open-screen" type="button" hidden>Open Android screen / 打开 Android 屏幕</button>
+</main>
+<script>
+(() => {
+  'use strict';
+  const form = document.getElementById('create-form');
+  const template = document.getElementById('template');
+  const submit = document.getElementById('submit');
+  const loading = document.getElementById('loading');
+  const error = document.getElementById('error');
+  const result = document.getElementById('result');
+  const openScreen = document.getElementById('open-screen');
+  let connection = null;
+  let screenWindow = null;
+
+  openScreen.addEventListener('click', () => {
+    if (!connection) return;
+    screenWindow = window.open('/android-screen.html', '_blank');
+    if (!screenWindow) {
+      error.textContent = 'Please allow pop-ups for this Dashboard, then try again.';
+      error.hidden = false;
+    }
+  });
+  window.addEventListener('message', event => {
+    if (event.origin !== location.origin || event.source !== screenWindow ||
+        event.data?.type !== 'android-screen-ready' || !connection) return;
+    screenWindow.postMessage({ type: 'android-screen-connect', ...connection }, location.origin);
+  });
+  window.addEventListener('pagehide', () => {
+    connection = null;
+    screenWindow = null;
+    openScreen.hidden = true;
+  });
+
+  function messageFrom(body) {
+    return body?.[0]?.error?.json?.message || body?.[0]?.error?.message || 'Sandbox creation failed.';
+  }
+
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    loading.hidden = false;
+    error.hidden = true;
+    result.hidden = true;
+    connection = null;
+    screenWindow = null;
+    openScreen.hidden = true;
+    submit.disabled = true;
+    template.disabled = true;
+
+    try {
+      const response = await fetch('/api/trpc/sandbox.openTerminal?batch=1', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify({ 0: { json: { template: template.value } } })
+      });
+      let body;
+      try {
+        body = await response.json();
+      } catch {
+        throw new Error('Dashboard returned an invalid response.');
+      }
+      if (!response.ok) throw new Error(messageFrom(body));
+      const data = body?.[0]?.result?.data?.json ?? body?.[0]?.result?.data;
+      const sandboxId = data?.sandboxId;
+      if (typeof sandboxId !== 'string' || !sandboxId) throw new Error('Dashboard did not return a sandbox ID.');
+
+      const link = document.createElement('a');
+      link.href = `/sandboxes/${encodeURIComponent(sandboxId)}/monitoring`;
+      link.textContent = sandboxId;
+      result.replaceChildren(document.createTextNode('Sandbox created: '), link);
+      result.hidden = false;
+      if (template.value === 'android-16') {
+        if (typeof data.trafficAccessToken !== 'string' || !data.trafficAccessToken) {
+          throw new Error('Sandbox was created, but no traffic access token was returned. Android screen connection is unavailable.');
+        }
+        connection = { sandboxId, trafficAccessToken: data.trafficAccessToken };
+        openScreen.hidden = false;
+      }
+    } catch (cause) {
+      error.textContent = cause instanceof Error ? cause.message : 'Sandbox creation failed.';
+      error.hidden = false;
+    } finally {
+      loading.hidden = true;
+      submit.disabled = false;
+      template.disabled = false;
+    }
+  });
+})();
+</script>
+</body>
+</html>
