+  -e CORS_ORIGIN -e PLAYWRIGHT_MODULE -e PLAYWRIGHT_EXECUTABLE_PATH \
+  -e "SCREENSHOT_PATH=/results/$SCREENSHOT_NAME" \
+  -v "$ROOT/verify-android-screen.mjs:/app/verify-android-screen.mjs:ro" \
+  -v "$SCREENSHOT_DIR:/results" \
+  base-template node /app/verify-android-screen.mjs
