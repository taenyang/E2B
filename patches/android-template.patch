+  assert.equal(timeoutInjected, true, 'screen timeout was not injected')
+  console.log('BROWSER_INITIAL_TRANSIENT_RECOVERY_PASS')
+  console.log('BROWSER_REFRESH_PASS')
+  const before = await hierarchy()
