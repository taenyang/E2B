+++ b/templates/android/USAGE.txt
@@ -0,0 +1,99 @@
+Android template patch
+======================
+
+This package adds an Android 16 amd64 template for SDK 2.63.0 and a Dashboard
+v0.4.0 screen/input page. The guest image is redroid 16.0.0 64only, fixed at
+720x1280 with 320 dpi. Android runs in a private sandbox: ADB is published only
+on guest loopback 127.0.0.1:5555, and the screen bridge is reached through the
+client-proxy with the sandbox traffic access token.
+
+Source layout:
+
+This directory is the complete portable Android extension source: guest runtime,
+kernel inputs, Dashboard page/patch/build recipe, and verification scripts.
+Maintain these files together. Generating patches/android-template.patch from
+this directory must preserve file contents and executable modes, mapping this
+directory to templates/android/ when applied in the E2B repository.
+
+The enclosing lab directory is not the package. VM disks, credentials, logs,
+image/source archives, compiled kernels, exported templates, and transfer tools
+are intentionally excluded. Editing sources or applying the patch does not
+update running containers or guest files.
+
+Keep responsibilities separate:
+- Embed deployment directory: Compose configuration, environment settings,
+  service launch, preflight and deployment verification. Select this directory
+  using E2B_EMBED_DIR; it consumes a prebuilt Dashboard image.
+- Generic Dashboard source directory: tutorial navigation and other generic
+  customizations, built independently into a Dashboard v0.4.0 base image.
+- This Android directory: screen and creation pages, private Android creation,
+  token forwarding, guest runtime and kernel inputs. Its Dashboard image can
+  extend either stock v0.4.0 or the generic Dashboard image.
+
+Do not copy Android HTML, patch scripts or Dockerfiles into the Embed deployment
+directory. Build this extension here, then select its image in deployment config.
+
+Deployment is three independent steps:
+
+1. Kernel. Build and verify kernel-input/build-kernel.sh with the pinned Amazon
+   Linux source archive supplied separately as its single archive-path argument.
+   The resulting kernel-output/vmlinux.bin must be installed and selected by the
+   local E2B orchestrator as kernel version 6.1.158-android-lab1, at
+   /fc-kernels/vmlinux-6.1.158-android-lab1/amd64/vmlinux.bin. The template
+   wrapper installs it there on the host where the wrapper runs; that must be
+   the kernel storage used by the target orchestrator. The source archive and
+   compiled kernel are intentionally not included here.
+2. Template. Serve this directory from a reviewed artifact endpoint. Set
+   E2B_EMBED_DIR, E2B_API_KEY, ANDROID_SETUP_URL, ANDROID_SETUP_SHA256,
+   ANDROID_ARTIFACT_BASE_URL, ANDROID_REDROID_IMAGE_ARCHIVE_URL, and
+   ANDROID_KERNEL_OUTPUT, then run ./run-template-build.sh. The setup script
+   downloads the separately prepared redroid image archive and the two guest
+   runtime files from the artifact endpoint. The setup URL is hash checked.
+3. Dashboard. Build dashboard.Dockerfile with this directory as its build
+   context and PUBLIC_SANDBOX_URL passed as a build argument containing the
+   browser reachable client-proxy base URL. From this source directory:
+
+       docker build -f dashboard.Dockerfile \
+         --build-arg PUBLIC_SANDBOX_URL="$PUBLIC_SANDBOX_URL" \
+         -t local/e2b-dashboard:v0.4.0-android-screen .
+
+   To retain generic Dashboard customizations, build that source separately
+   first, then add --build-arg DASHBOARD_BASE_IMAGE=<generic-image-tag> to the
+   command above. Both layers must target Dashboard v0.4.0. The Android patch
+   preserves existing navigation entries and versions its modified assets.
+   Dockerfile-specific ignore files restrict each build to its UI sources.
+
+   Use this directory's compose.override.yaml as an additional explicit -f
+   file after the existing Embed compose.yaml and deployment overrides. Keep
+   --project-directory pointing at E2B_EMBED_DIR. Do not replace the existing
+   deployment overrides. The Android override changes only the Dashboard image
+   and public sandbox URL. The page URL is baked into the image; changing it
+   requires rebuilding. Build and Compose commands are deployment steps and
+   are not performed by the offline checks.
+
+The Dashboard menu adds Android navigation and routes creation to the packaged
+sandbox-create.html page, which retains both base and android-16 creation.
+The Android patch makes android-16 creation private and passes trafficAccessToken
+through the existing connection object. After creation, Open Android screen
+passes the connection to the screen window using an origin/source-checked
+postMessage handshake. The screen page also accepts a manually supplied Sandbox
+ID and traffic access token. Tokens are kept in memory, cleared on page exit
+(and on screen disconnect), and sent to the proxy only in the request header.
+
+Offline check:
+
+    pnpm run test
+
+This checks JavaScript and shell syntax, the Dashboard patch self-test on stock
+and customized menus, base/Android creation and credential handoff using a local
+DOM harness, the bridge self-check, and kernel input hashes/config requirements. It
+does not compile the kernel, pull images, contact E2B, create sandboxes, or run
+online Android/browser acceptance. Run run-template-verify.sh for the online
+Android lifecycle/input/screenshot/token-isolation checks and
+run-browser-verify.sh for Dashboard recovery, input, token hygiene, and
+pause/resume checks after all three deployment steps are complete.
+
+Browser verification requires PLAYWRIGHT_MODULE and optionally
+PLAYWRIGHT_EXECUTABLE_PATH. It also requires E2B_API_KEY, E2B_API_URL,
+E2B_SANDBOX_URL, DASHBOARD_URL, and CORS_ORIGIN; credentials are never read
+from a fixed file path.
diff --git a/templates/android/android-screen-bridge.py b/templates/android/android-screen-bridge.py
new file mode 100755
index 0000000..8f61d8d
--- /dev/null
+++ b/templates/android/android-screen-bridge.py
@@ -0,0 +1,266 @@
+#!/usr/bin/env python3
+"""Private Android screen/input bridge; access control belongs to client-proxy."""
+import json
+import shlex
+import socket
+import struct
+import subprocess
+import sys
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+ADB = ['adb', '-s', '127.0.0.1:5555']
+KEYS = {'HOME', 'BACK', 'ENTER', 'DEL', 'TAB', 'DPAD_UP', 'DPAD_DOWN',
+        'DPAD_LEFT', 'DPAD_RIGHT', 'APP_SWITCH'}
+MAX_BODY = 4096
+
+
+def input_args(body):
+    value = json.loads(body)
+    if not isinstance(value, dict) or not isinstance(value.get('action'), str):
+        raise ValueError('invalid input')
+    action = value['action']
+    fields = {'tap': {'x', 'y'}, 'swipe': {'x1', 'y1', 'x2', 'y2', 'duration'},
+              'key': {'key'}, 'text': {'text'}}
+    if action not in fields or set(value) != fields[action] | {'action'}:
+        raise ValueError('invalid action or fields')
+    for name in fields[action] - {'key', 'text'}:
+        low, high = (50, 2000) if name == 'duration' else (0, 719 if name.startswith('x') else 1279)
+        if type(value[name]) is not int or not low <= value[name] <= high:
+            raise ValueError('invalid coordinate or duration')
+    if action == 'tap':
+        args = ['tap', str(value['x']), str(value['y'])]
+    elif action == 'swipe':
+        args = ['swipe'] + [str(value[k]) for k in ('x1', 'y1', 'x2', 'y2', 'duration')]
+    elif action == 'key':
+        if not isinstance(value['key'], str) or value['key'] not in KEYS:
+            raise ValueError('invalid key')
+        args = ['keyevent', 'KEYCODE_' + value['key']]
+    else:
+        text = value['text']
+        if (not isinstance(text, str) or not 1 <= len(text) <= 256
+                or any(not 32 <= ord(c) <= 126 for c in text) or '%s' in text):
+            raise ValueError('text must be 1-256 printable ASCII characters without %s')
+        # adb shell joins arguments into a remote shell command; host argv alone is insufficient.
+        args = ['text', shlex.quote(text.replace(' ', '%s'))]
+    return ADB + ['shell', 'input'] + args
+
+
+def adb(argv):
+    return subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                          stderr=subprocess.DEVNULL, timeout=8, check=True).stdout
+
+
+def valid_png(png):
+    if not png.startswith(b'\x89PNG\r\n\x1a\n'):
+        return False
+    offset = 8
+    saw_idat = False
+    while offset + 12 <= len(png):
+        length = struct.unpack_from('>I', png, offset)[0]
+        end = offset + 12 + length
+        if end > len(png):
+            return False
+        kind = png[offset + 4:offset + 8]
+        data = png[offset + 8:offset + 8 + length]
+        checksum = struct.unpack_from('>I', png, offset + 8 + length)[0]
+        if zlib.crc32(kind + data) & 0xffffffff != checksum:
+            return False
+        if offset == 8:
+            if kind != b'IHDR' or length != 13:
+                return False
+            width, height = struct.unpack_from('>II', data)
+            if (width, height) != (720, 1280):
+                return False
+        elif kind == b'IDAT':
+            saw_idat = True
+        if kind == b'IEND':
+            return saw_idat and length == 0 and end == len(png)
+        offset = end
+    return False
+
+
+def screenshot():
+    png = adb(ADB + ['exec-out', 'screencap', '-p'])
+    return png if valid_png(png) else None
+
+
+class Handler(BaseHTTPRequestHandler):
+    def setup(self):
+        super().setup()
+        self.connection.settimeout(5)
+
+    def log_message(self, *_):
+        pass
+
+    def reply(self, status, body=b'', content_type='application/json'):
+        self.send_response(status)
+        self.send_header('Content-Type', content_type)
+        self.send_header('Content-Length', str(len(body)))
+        self.send_header('Cache-Control', 'no-store')
+        self.send_header('Access-Control-Allow-Origin', '*')
+        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
+        self.send_header('Access-Control-Allow-Headers',
+                         'Content-Type, E2B-Sandbox-Id, E2B-Sandbox-Port, e2b-traffic-access-token')
+        self.send_header('X-Content-Type-Options', 'nosniff')
+        self.end_headers()
+        self.wfile.write(body)
+
+    def send_error(self, code, message=None, explain=None):
+        self.reply(code, b'{"error":"request failed"}')
+
+    def do_OPTIONS(self):
+        self.reply(204 if self.path in ('/health', '/screen', '/input') else 404)
+
+    def do_GET(self):
+        try:
+            if self.path == '/health':
+                if adb(ADB + ['shell', 'getprop', 'sys.boot_completed']).strip() != b'1':
+                    self.reply(503, b'{"error":"Android unavailable"}')
+                    return
+                if screenshot() is None:
+                    self.reply(503, b'{"error":"screen unavailable"}')
+                    return
+                self.reply(200, b'{"ready":true,"width":720,"height":1280}')
+            elif self.path == '/screen':
+                png = screenshot()
+                if png is None:
+                    self.reply(503, b'{"error":"screen unavailable"}')
+                else:
+                    self.reply(200, png, 'image/png')
+            else:
+                self.reply(404, b'{"error":"not found"}')
+        except (OSError, subprocess.SubprocessError):
+            self.reply(503, b'{"error":"Android unavailable"}')
+
+    def do_POST(self):
+        if self.path != '/input':
+            self.reply(404, b'{"error":"not found"}')
+            return
+        try:
+            lengths = self.headers.get_all('Content-Length', [])
+            if self.headers.get('Transfer-Encoding') or len(lengths) != 1:
+                raise ValueError('invalid framing')
+            length = int(lengths[0])
+            if not 0 < length <= MAX_BODY:
+                self.reply(413, b'{"error":"request too large"}')
+                return
+            if self.headers.get_content_type() != 'application/json':
+                self.reply(415, b'{"error":"JSON required"}')
+                return
+            body = self.rfile.read(length)
+            if len(body) != length:
+                raise ValueError('incomplete body')
+            argv = input_args(body)
+        except (ValueError, UnicodeError, RecursionError):
+            self.reply(400, b'{"error":"invalid input"}')
+            return
+        except (OSError, socket.timeout):
+            self.reply(408, b'{"error":"request timeout"}')
+            return
+        try:
+            adb(argv)
+            self.reply(200, b'{"ok":true}')
+        except (OSError, subprocess.SubprocessError):
+            self.reply(503, b'{"error":"Android unavailable"}')
+
+
+def self_check():
+    import threading
+    import urllib.error
+    import urllib.request
+    from unittest.mock import patch
+
+    def chunk(kind, data):
+        return (struct.pack('>I', len(data)) + kind + data +
+                struct.pack('>I', zlib.crc32(kind + data) & 0xffffffff))
+
+    raw = (b'\0' + b'\0' * (720 * 4)) * 1280
+    valid_screen = (b'\x89PNG\r\n\x1a\n' +
+                    chunk(b'IHDR', struct.pack('>IIBBBBB', 720, 1280, 8, 6, 0, 0, 0)) +
+                    chunk(b'IDAT', zlib.compress(raw)) + chunk(b'IEND', b''))
+    state = {'boot': b'0\n', 'screen': b'invalid', 'screen_error': False}
+    commands = []
+
+    def fake_run(argv, **kwargs):
+        assert kwargs['timeout'] == 8 and kwargs.get('shell', False) is False
+        assert argv[:3] == ADB
+        commands.append(argv)
+        if argv[-3:] == ['shell', 'getprop', 'sys.boot_completed']:
+            return subprocess.CompletedProcess(argv, 0, state['boot'])
+        if argv[-3:] == ['exec-out', 'screencap', '-p']:
+            if state['screen_error']:
+                raise subprocess.CalledProcessError(1, argv)
+            return subprocess.CompletedProcess(argv, 0, state['screen'])
+        return subprocess.CompletedProcess(argv, 0, b'1\n')
+
+    server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+
+    def get(path):
+        try:
+            with urllib.request.urlopen('http://127.0.0.1:%s%s' % (server.server_port, path), timeout=10) as res:
+                return res.status, res.read()
+        except urllib.error.HTTPError as error:
+            return error.code, error.read()
+
+    def post(data):
+        req = urllib.request.Request('http://127.0.0.1:%s/input' % server.server_port,
+                                     data=data, headers={'Content-Type': 'application/json'})
+        try:
+            with urllib.request.urlopen(req, timeout=10) as res:
+                assert res.headers['Cache-Control'] == 'no-store'
+                return res.status
+        except urllib.error.HTTPError as error:
+            return error.code
+
+    try:
+        with patch('subprocess.run', fake_run):
+            before = len(commands)
+            assert get('/health')[0] == 503
+            assert not any(command[-3:] == ['exec-out', 'screencap', '-p'] for command in commands[before:])
+            assert get('/screen')[0] == 503
+            state['boot'] = b'1\n'
+            assert get('/health')[0] == 503
+            state['screen'] = valid_screen
+            assert get('/health')[0] == 200
+            status, body = get('/screen')
+            assert status == 200 and valid_png(body)
+            state['screen_error'] = True
+            assert get('/health')[0] == 503
+            assert get('/screen')[0] == 503
+            state['screen_error'] = False
+            for value in ({'action': 'tap', 'x': 0, 'y': 1279},
+                          {'action': 'swipe', 'x1': 0, 'y1': 0, 'x2': 719, 'y2': 1279, 'duration': 2000},
+                          {'action': 'key', 'key': 'HOME'},
+                          {'action': 'text', 'text': "hello ';$(touch /tmp/bridge-injection)&`id`|<>\\\""}):
+                assert post(json.dumps(value).encode()) == 200
+            assert shlex.split(' '.join(commands[-1][3:])) == [
+                'shell', 'input', 'text', "hello%s';$(touch%s/tmp/bridge-injection)&`id`|<>\\\""]
+            count = len(commands)
+            invalid = [b'{', b'[]', b'null', b'\xff', b'[' * 2000]
+            invalid += [json.dumps(v).encode() for v in (
+                {'action': 'tap', 'x': 720, 'y': 0}, {'action': 'tap', 'x': True, 'y': 0},
+                {'action': 'tap', 'x': 0, 'y': -1}, {'action': 'tap', 'x': 0, 'y': 1280},
+                {'action': 'text', 'text': 'a' * 257}, {'action': 'text', 'text': 'a\nb'},
+                {'action': 'text', 'text': '%s'}, {'action': 'text', 'text': '中文'},
+                {'action': 'key', 'key': 'HOME;id'}, {'action': 'key', 'key': []},
+                {'action': 'exec', 'command': 'id'}, {'action': []},
+                {'action': 'swipe', 'x1': 0, 'y1': 0, 'x2': 0, 'y2': 0, 'duration': 2001})]
+            for value in invalid:
+                assert post(value) == 400
+            assert post(b'x' * (MAX_BODY + 1)) == 413
+            assert len(commands) == count
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+    print('BRIDGE_SELF_CHECK_PASS')
+
+
+if __name__ == '__main__':
+    if sys.argv[1:] == ['--self-check']:
+        self_check()
+    else:
+        ThreadingHTTPServer(('0.0.0.0', 8080), Handler).serve_forever()
