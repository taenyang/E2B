+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import { Sandbox } from 'e2b'
+
+const sandboxes = []
+function required(name) {
+  const value = process.env[name]
+  if (!value) throw new Error(`${name} is required`)
+  return value
+}
+const proxy = required('E2B_SANDBOX_URL').replace(/\/+$/, '')
+const apiUrl = required('E2B_API_URL').replace(/\/+$/, '')
+const apiKey = required('E2B_API_KEY')
+const corsOrigin = required('CORS_ORIGIN')
+const resultsDir = process.env.RESULTS_DIR || '/tmp/android-results'
+fs.mkdirSync(resultsDir, { recursive: true })
+function crc32(bytes) {
+  let crc = 0xffffffff
+  for (const byte of bytes) {
+    crc ^= byte
+    for (let bit = 0; bit < 8; bit++) crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1))
+  }
+  return (crc ^ 0xffffffff) >>> 0
+}
+function validPng(png) {
+  if (!png.subarray(0, 8).equals(Buffer.from('89504e470d0a1a0a', 'hex'))) return false
+  let offset = 8
+  let sawIdat = false
+  while (offset + 12 <= png.length) {
+    const length = png.readUInt32BE(offset)
+    const end = offset + 12 + length
+    if (end > png.length) return false
+    const kind = png.subarray(offset + 4, offset + 8)
+    const data = png.subarray(offset + 8, offset + 8 + length)
+    const checksum = png.readUInt32BE(offset + 8 + length)
+    if (crc32(Buffer.concat([kind, data])) !== checksum) return false
+    if (offset === 8) {
+      if (!kind.equals(Buffer.from('IHDR')) || length !== 13 || data.readUInt32BE(0) !== 720 || data.readUInt32BE(4) !== 1280) return false
+    } else if (kind.equals(Buffer.from('IDAT'))) {
+      sawIdat = true
+    }
+    if (kind.equals(Buffer.from('IEND'))) return sawIdat && length === 0 && end === png.length
+    offset = end
+  }
+  return false
+}
+async function bridge(sandbox, path, input) {
+  const response = await fetch(`${proxy}${path}`, {
+    method: input ? 'POST' : 'GET',
+    headers: {
+      'E2B-Sandbox-Id': sandbox.sandboxId,
+      'E2B-Sandbox-Port': '8080',
+      'e2b-traffic-access-token': sandbox.trafficAccessToken,
+      ...(input ? { 'Content-Type': 'application/json' } : {}),
+    },
+    ...(input ? { body: JSON.stringify(input) } : {}),
+    signal: AbortSignal.timeout(15000),
+  })
+  assert.equal(response.status, 200, `bridge ${path} status`)
+  assert.equal(response.headers.get('cache-control'), 'no-store')
+  const contentType = response.headers.get('content-type')?.split(';', 1)[0]
+  assert.equal(contentType, path === '/screen' ? 'image/png' : 'application/json')
+  return response
+}
+async function listedIds() {
+  const response = await fetch(`${apiUrl}/sandboxes`, {
+    headers: { 'X-API-Key': apiKey },
+  })
+  assert.equal(response.status, 200)
+  return (await response.json()).map(sandbox => sandbox.sandboxID)
+}
+async function run(sandbox, command) {
+  const result = await sandbox.commands.run(command, { timeoutMs: 120000 })
+  assert.equal(result.exitCode, 0, `${command}\n${result.stderr}`)
+  return result.stdout.trim()
+}
+async function assertPausedHealthFails(sandbox) {
+  await run(sandbox, 'sudo -n docker pause android')
+  try {
+    let status
+    try {
+      status = (await fetch(`${proxy}/health`, {
+        headers: {
+          'E2B-Sandbox-Id': sandbox.sandboxId,
+          'E2B-Sandbox-Port': '8080',
+          'e2b-traffic-access-token': sandbox.trafficAccessToken,
+        },
+        signal: AbortSignal.timeout(10000),
+      })).status
+    } catch (error) {
+      assert.ok(error instanceof TypeError || ['AbortError', 'TimeoutError'].includes(error.name), 'paused health returned an unexpected error')
+      status = null
+    }
+    if (status !== null) assert.ok([502, 503, 504].includes(status), 'paused Android health unexpectedly succeeded')
+  } finally {
+    await run(sandbox, 'sudo -n docker unpause android')
+  }
+  assert.deepEqual(await (await bridge(sandbox, '/health')).json(), { ready: true, width: 720, height: 1280 })
+}
+try {
+  for (let i = 0; i < 2; i++) {
+    const sandbox = await Sandbox.create('android-16', {
+      timeoutMs: 600000, network: { allowPublicTraffic: false },
+    })
+    sandboxes.push(sandbox)
+    console.log(`sandbox${i + 1}=${sandbox.sandboxId}`)
+    assert.ok(sandbox.trafficAccessToken)
+    await run(sandbox, 'sudo -n python3 /opt/android/android-screen-bridge.py --self-check')
+    const health = await (await bridge(sandbox, '/health')).json()
+    assert.deepEqual(health, { ready: true, width: 720, height: 1280 })
+    if (i === 0) await assertPausedHealthFails(sandbox)
+    const headers = { 'E2B-Sandbox-Id': sandbox.sandboxId, 'E2B-Sandbox-Port': '8080' }
+    for (const token of ['', 'invalid']) {
+      const denied = await fetch(`${proxy}/health`, {
+        headers: { ...headers, 'e2b-traffic-access-token': token },
+      })
+      assert.equal(denied.status, 403)
+    }
+    const options = await fetch(`${proxy}/input`, {
+      method: 'OPTIONS', headers: { ...headers, 'e2b-traffic-access-token': sandbox.trafficAccessToken,
+        Origin: corsOrigin, 'Access-Control-Request-Method': 'POST',
+        'Access-Control-Request-Headers': 'content-type,e2b-sandbox-id,e2b-sandbox-port,e2b-traffic-access-token' },
+    })
+    assert.ok(options.ok)
+    assert.ok(options.headers.get('access-control-allow-origin'))
+    const frame = Buffer.from(await (await bridge(sandbox, '/screen')).arrayBuffer())
+    assert.ok(validPng(frame), 'bridge returned an incomplete or invalid 720x1280 PNG')
+    await bridge(sandbox, '/input', { action: 'key', key: 'HOME' })
+    await bridge(sandbox, '/input', { action: 'tap', x: 360, y: 640 })
+    await bridge(sandbox, '/input', { action: 'swipe', x1: 360, y1: 1000, x2: 360, y2: 400, duration: 300 })
+    await bridge(sandbox, '/input', { action: 'text', text: "';touch /data/local/tmp/bridge-injection;#" })
+    await run(sandbox, 'adb -s 127.0.0.1:5555 shell test ! -e /data/local/tmp/bridge-injection')
+    assert.match(await run(sandbox, 'sudo -n docker port android 5555'), /^127\.0\.0\.1:5555$/)
+    await run(sandbox, 'adb connect 127.0.0.1:5555')
+    assert.equal(await run(sandbox, 'adb -s 127.0.0.1:5555 shell getprop ro.build.version.release'), '16')
+    assert.equal(await run(sandbox, 'adb -s 127.0.0.1:5555 shell getprop ro.build.version.sdk'), '36')
+    assert.equal(await run(sandbox, 'adb -s 127.0.0.1:5555 shell getprop sys.boot_completed'), '1')
+    await run(sandbox, 'adb -s 127.0.0.1:5555 shell test ! -e /data/local/tmp/e2b-isolation.txt')
+    await run(sandbox, `adb -s 127.0.0.1:5555 shell 'echo instance-${i} > /data/local/tmp/e2b-isolation.txt'`)
+    console.log(await run(sandbox, 'adb -s 127.0.0.1:5555 shell am start -W -n com.android.settings/.Settings'))
+    await run(sandbox, 'adb -s 127.0.0.1:5555 shell uiautomator dump /sdcard/window.xml')
+    await run(sandbox, 'adb -s 127.0.0.1:5555 shell input keyevent KEYCODE_BACK')
+    await run(sandbox, 'adb -s 127.0.0.1:5555 exec-out screencap -p > /tmp/android.png')
+    const png = Buffer.from(await sandbox.files.read('/tmp/android.png', { format: 'bytes' }))
+    assert.ok(validPng(png), 'ADB returned an incomplete or invalid 720x1280 PNG')
+    fs.writeFileSync(`${resultsDir}/android-${i + 1}.png`, png)
+    await sandbox.files.write('/tmp/envd-check.txt', 'envd-ok\n')
+    assert.equal(await sandbox.files.read('/tmp/envd-check.txt'), 'envd-ok\n')
+    await run(sandbox, 'apk=$(adb -s 127.0.0.1:5555 shell pm path com.android.music | tr -d "\\r"); test -n "$apk"; adb -s 127.0.0.1:5555 pull "${apk#package:}" /tmp/install-check.apk')
+    const apk = await sandbox.files.read('/tmp/install-check.apk', { format: 'bytes' })
+    await sandbox.files.write('/tmp/upload-check.apk', apk)
+    const install = await run(sandbox, 'adb -s 127.0.0.1:5555 install -r -g /tmp/upload-check.apk')
+    assert.match(install, /Success/)
+    console.log(`instance${i + 1}: Android16/API36/boot/UI/PNG/envd/APK-install passed`)
+  }
+  assert.equal(await run(sandboxes[0], 'adb -s 127.0.0.1:5555 shell cat /data/local/tmp/e2b-isolation.txt'), 'instance-0')
+  const visible = await listedIds()
+  for (const sandbox of sandboxes) assert.ok(visible.includes(sandbox.sandboxId), 'Android sandbox missing from API list')
+  const crossed = await fetch(`${proxy}/health`, { headers: {
+    'E2B-Sandbox-Id': sandboxes[1].sandboxId, 'E2B-Sandbox-Port': '8080',
+    'e2b-traffic-access-token': sandboxes[0].trafficAccessToken,
+  } })
+  assert.equal(crossed.status, 403)
+  await bridge(sandboxes[0], '/input', { action: 'key', key: 'HOME' })
+  await run(sandboxes[1], 'adb -s 127.0.0.1:5555 shell am start -W -n com.android.settings/.Settings')
+  const firstScreen = Buffer.from(await (await bridge(sandboxes[0], '/screen')).arrayBuffer())
+  const secondScreen = Buffer.from(await (await bridge(sandboxes[1], '/screen')).arrayBuffer())
+  assert.notDeepEqual(firstScreen, secondScreen)
+  assert.match(await run(sandboxes[1], 'adb -s 127.0.0.1:5555 shell dumpsys activity activities'), /topResumedActivity=.*com\.android\.settings/)
+  console.log('ANDROID_SNAPSHOT_AND_ISOLATION_PASS; API_LIST_VISIBILITY_PASS; PRIVATE_SCREEN_INPUT_PASS')
+} finally {
+  const cleanup = await Promise.allSettled(sandboxes.map(async sandbox => {
+    await sandbox.kill()
+    console.log(`killed=${sandbox.sandboxId}`)
+  }))
+  const failures = cleanup.filter(result => result.status === 'rejected')
+  if (failures.length) throw new AggregateError(failures.map(result => result.reason), 'Sandbox cleanup failed')
+  const remaining = await listedIds()
+  for (const sandbox of sandboxes) assert.ok(!remaining.includes(sandbox.sandboxId), 'Killed sandbox still listed')
+  console.log('LIFECYCLE_CLEANUP_PASS')
+}
diff --git a/templates/android/verify-dashboard-create.mjs b/templates/android/verify-dashboard-create.mjs
new file mode 100644
index 0000000..6fd7ba2
--- /dev/null
+++ b/templates/android/verify-dashboard-create.mjs
@@ -0,0 +1,131 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import vm from 'node:vm'
+
+const pages = {}
+for (const name of ['sandbox-create', 'android-screen']) {
+  const html = readFileSync(new URL(`./${name}.html`, import.meta.url), 'utf8')
+  const scripts = [...html.matchAll(/<script\b[^>]*>([\s\S]*?)<\/script>/gi)]
+  assert.equal(scripts.length, 1, `${name}: expected one inline script`)
+  pages[name] = { html, script: new vm.Script(scripts[0][1], { filename: `${name}.html` }) }
+}
+const origin = 'https://dashboard.example'
+const token = 'offline-test-token'
+const success = data => ({ ok: true, json: async () => [{ result: { data } }] })
+function target() {
+  const handlers = {}
+  return {
+    addEventListener(type, handler) { assert.ok(!handlers[type]); handlers[type] = handler },
+    fire(type, event = {}) { assert.ok(handlers[type], `missing ${type} handler`); return handlers[type](event) },
+  }
+}
+function dashboard() {
+  const elements = Object.fromEntries([...pages['sandbox-create'].html.matchAll(/<[^>]+\bid="([^"]+)"[^>]*>/g)]
+    .map(([tag, id]) => [id, { ...target(), hidden: /\bhidden\b/.test(tag), disabled: false, textContent: '',
+      replaceChildren(...children) { this.children = children } }]))
+  const messages = [], opens = [], requests = []
+  let reply, popup
+  const window = { ...target(), open(...args) {
+    opens.push(args)
+    popup = { postMessage: (data, destination) => messages.push([JSON.parse(JSON.stringify(data)), destination]) }
+    return popup
+  } }
+  pages['sandbox-create'].script.runInNewContext({ window, location: { origin }, document: {
+    getElementById: id => { assert.ok(elements[id], `unknown element ${id}`); return elements[id] },
+    createElement: tagName => ({ tagName }), createTextNode: textContent => ({ textContent }),
+  }, fetch: async (...args) => { requests.push(args); return reply } })
+  return {
+    elements, messages, opens, requests, window,
+    submit(template, response) {
+      elements.template.value = template
+      reply = response
+      let prevented = false
+      const pending = elements['create-form'].fire('submit', { preventDefault() { prevented = true } })
+      assert.ok(prevented)
+      assert.equal(elements.loading.hidden, false)
+      assert.equal(elements.submit.disabled, true)
+      assert.equal(elements.template.disabled, true)
+      return pending
+    },
+    open() { elements['open-screen'].fire('click') },
+    ready(overrides = {}) {
+      window.fire('message', { origin, source: popup, data: { type: 'android-screen-ready' }, ...overrides })
+    },
+    settled() {
+      assert.equal(elements.loading.hidden, true)
+      assert.equal(elements.submit.disabled, false)
+      assert.equal(elements.template.disabled, false)
+    },
+    cleared() {
+      assert.equal(elements['open-screen'].hidden, true)
+      const sent = messages.length, opened = opens.length
+      this.ready()
+      this.open()
+      this.ready()
+      assert.equal(messages.length, sent, 'cleared credentials were handed off')
+      assert.equal(opens.length, opened, 'cleared connection still opened a screen')
+    },
+  }
+}
+
+const base = dashboard()
+await base.submit('base', success({ json: { sandboxId: 'base/id ?' } }))
+base.settled()
+assert.equal(base.elements.error.hidden, true)
+assert.equal(base.elements.result.hidden, false)
+assert.deepEqual(base.elements.result.children, [
+  { textContent: 'Sandbox created: ' },
+  { tagName: 'a', href: '/sandboxes/base%2Fid%20%3F/monitoring', textContent: 'base/id ?' },
+])
+base.cleared()
+const [url, options] = base.requests[0]
+assert.equal(url, '/api/trpc/sandbox.openTerminal?batch=1')
+assert.equal(options.method, 'POST')
+assert.equal(options.credentials, 'same-origin')
+assert.equal(options.headers['Content-Type'], 'application/json')
+assert.deepEqual(JSON.parse(options.body), { 0: { json: { template: 'base' } } })
+
+for (const clear of ['pagehide', 'submit']) {
+  const d = dashboard()
+  await d.submit('android-16', success({ sandboxId: 'android-id', trafficAccessToken: token }))
+  d.settled()
+  assert.equal(d.elements.error.hidden, true)
+  assert.equal(d.elements['open-screen'].hidden, false)
+  assert.deepEqual(JSON.parse(d.requests[0][1].body), { 0: { json: { template: 'android-16' } } })
+  d.open()
+  assert.deepEqual(d.opens, [['/android-screen.html', '_blank']])
+  assert.deepEqual(d.messages, [], 'token sent before readiness handshake')
+  for (const event of [{ origin: 'https://other.example' }, { source: {} }, { data: null }, { data: { type: 'other' } }]) {
+    d.ready(event)
+    assert.deepEqual(d.messages, [], 'untrusted handshake received credentials')
+  }
+  d.ready()
+  assert.deepEqual(d.messages, [[{ type: 'android-screen-connect', sandboxId: 'android-id', trafficAccessToken: token }, origin]])
+  assert.ok(!JSON.stringify(d.elements).includes(token), 'token leaked into DOM')
+  let pending, resolve
+  if (clear === 'pagehide') d.window.fire('pagehide')
+  else pending = d.submit('base', new Promise(done => { resolve = done }))
+  d.cleared()
+  if (pending) {
+    resolve(success({ sandboxId: 'new-base' }))
+    await pending
+    d.settled()
+    d.cleared()
+  }
+}
+
+for (const [response, message, created] of [
+  ...[undefined, '', 123].map(trafficAccessToken => [success({ sandboxId: 'android-id', trafficAccessToken }), /no traffic access token/, true]),
+  [{ ok: true, json: async () => { throw new SyntaxError('bad JSON') } }, /Dashboard returned an invalid response\./, false],
+  [success({}), /did not return a sandbox ID/, false],
+  [{ ok: false, json: async () => [{ error: { json: { message: 'Creation denied' } } }] }, /Creation denied/, false],
+]) {
+  const d = dashboard()
+  await d.submit('android-16', response)
+  d.settled()
+  assert.equal(d.elements.error.hidden, false)
+  assert.match(d.elements.error.textContent, message)
+  assert.equal(d.elements.result.hidden, !created)
+  d.cleared()
+}
+console.log('PASS: inline syntax, base creation, Android handoff guards, credential clearing, and creation failures')
