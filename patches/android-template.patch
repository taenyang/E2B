@@ -0,0 +1,383 @@
+<!doctype html>
+<html lang="zh-CN">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="referrer" content="no-referrer">
+  <title>Android 屏幕 · E2B Embed</title>
+  <style>
+    :root { color-scheme: light; font:16px/1.6 system-ui,sans-serif; color:#172033; background:#f5f7fb; }
+    * { box-sizing:border-box; }
+    main { max-width:1080px; margin:auto; padding:24px; }
+    a { color:#174eb5; }
+    h1 { margin-bottom:8px; }
+    .card { background:white; border:1px solid #dfe4ee; border-radius:12px; padding:20px; margin:20px 0; }
+    .layout { display:grid; grid-template-columns:minmax(0,360px) minmax(0,1fr); gap:24px; align-items:start; }
+    .row { display:flex; flex-wrap:wrap; gap:12px; align-items:end; margin:12px 0; }
+    label { display:block; }
+    input,button { font:inherit; border:1px solid #65738a; border-radius:6px; padding:8px 12px; min-height:44px; }
+    input { max-width:100%; background:#fff; color:#172033; }
+    input[type=number] { width:100px; }
+    button { cursor:pointer; background:#edf3ff; color:#173b8f; }
+    button:disabled { cursor:default; opacity:.55; }
+    :focus-visible { outline:3px solid #2563eb; outline-offset:3px; }
+    fieldset { min-width:0; margin:16px 0; border:1px solid #dfe4ee; border-radius:8px; }
+    #screen { display:block; width:100%; height:auto; background:#172033; touch-action:none; }
+    #screen[aria-disabled=true] { opacity:.45; }
+    #status { font-weight:600; }
+    pre { overflow:auto; background:#111827; color:#e5e7eb; border-radius:8px; padding:16px; }
+    .hint { color:#475569; }
+    @media(max-width:720px) { .layout { grid-template-columns:1fr; } #screen { max-width:360px; margin:auto; } main { padding:16px; } }
+  </style>
+</head>
+<body>
+<main>
+  <a href="/">返回 Dashboard</a>
+  <h1>Android 屏幕</h1>
+  <p>在<a href="/sandbox-create.html">创建页面</a>选择 android-16，创建后点击“打开 Android 屏幕”即可自动连接。也可在可信的 SDK 环境中创建沙箱并设置 <code>network.allowPublicTraffic: false</code>，再填写 Sandbox ID 和流量访问令牌连接。连接后，本页会把令牌通过请求头交给后端代理，由代理转发屏幕和输入请求；本页不自动创建沙箱。连接信息仅在页面内存中使用，不写入地址栏、浏览器存储或页面日志。</p>
+  <div class="card">
+    <form id="connect-form" autocomplete="off">
+      <div class="row">
+        <label>Sandbox ID<br><input id="sandbox-id" required maxlength="128" autocomplete="off" autocapitalize="none" spellcheck="false"></label>
+        <label>Traffic access token<br><input id="traffic-token" type="password" required maxlength="4096" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="credential-hint"></label>
+        <button type="submit">连接 / 重新连接</button>
+        <button id="disconnect" type="button" disabled>断开</button>
+      </div>
+    </form>
+    <p id="credential-hint" class="hint">提交后立即清空 ID 和令牌输入框；不写入地址栏、浏览器存储或页面日志。</p>
+    <p id="status" role="status" aria-live="polite">未连接</p>
+  </div>
+  <div class="layout">
+    <div>
+      <canvas id="screen" width="720" height="1280" tabindex="0" role="img" aria-label="Android 屏幕，720 × 1280" aria-disabled="true" aria-describedby="screen-hint"></canvas>
+      <p id="screen-hint" class="hint">点击屏幕轻触，拖动屏幕滑动。屏幕获得焦点后，可用方向键移动、Enter 确认、Backspace/Delete 删除、Escape 返回、Home 回到主页。也可使用坐标与按键控件操作。</p>
+    </div>
+    <div>
+      <fieldset id="controls" disabled>
+        <legend>Android 操作</legend>
+        <div id="keys" class="row" aria-label="Android 按键">
+          <button type="button" data-key="HOME">主页</button>
+          <button type="button" data-key="BACK">返回</button>
+          <button type="button" data-key="APP_SWITCH">最近应用</button>
+          <button type="button" data-key="ENTER">确认 / Enter</button>
+          <button type="button" data-key="DEL">删除 / Backspace</button>
+          <button type="button" data-key="TAB">Tab</button>
+          <button type="button" data-key="DPAD_UP">上</button>
+          <button type="button" data-key="DPAD_DOWN">下</button>
+          <button type="button" data-key="DPAD_LEFT">左</button>
+          <button type="button" data-key="DPAD_RIGHT">右</button>
+        </div>
+        <form id="text-form" autocomplete="off">
+          <label for="text">输入文字</label>
+          <input id="text" maxlength="256" required autocomplete="off" spellcheck="false" aria-describedby="text-hint">
+          <button type="submit">发送文字</button>
+          <p id="text-hint" class="hint">仅支持可打印 ASCII（英文、数字、空格、标点），最多 256 字符。不支持中文、换行或字面组合 %s（Android 将其作为空格转义）。</p>
+        </form>
+        <form id="coordinates" autocomplete="off">
+          <div class="row">
+            <label>起点 X<input id="x1" type="number" min="0" max="719" step="1" value="360" required></label>
+            <label>起点 Y<input id="y1" type="number" min="0" max="1279" step="1" value="640" required></label>
+            <button type="submit" value="tap">轻触起点</button>
+          </div>
+          <div class="row">
+            <label>终点 X<input id="x2" type="number" min="0" max="719" step="1" value="360" required></label>
+            <label>终点 Y<input id="y2" type="number" min="0" max="1279" step="1" value="320" required></label>
+            <label>时长 (ms)<input id="duration" type="number" min="50" max="2000" step="1" value="300" required></label>
+            <button type="submit" value="swipe">滑动</button>
+          </div>
+        </form>
+      </fieldset>
+      <p id="input-status" role="status" aria-live="polite"></p>
+    </div>
+  </div>
+  <noscript>请启用 JavaScript 后连接 Android 屏幕。</noscript>
+</main>
+<script>
+(() => {
+  'use strict';
+  const proxyBase = __PUBLIC_SANDBOX_URL_JSON__;
+  const $ = id => document.getElementById(id);
+  const screen = $('screen');
+  const ctx = screen.getContext('2d');
+  let session = null;
+  let gesture = null;
+  const RECOVERY_WINDOW = 30000;
+  const RETRY_DELAYS = [250, 500, 1000, 2000];
+
+  function disconnect(message = '未连接') {
+    const old = session;
+    session = null;
+    if (old) {
+      clearTimeout(old.poll);
+      old.controller.abort();
+      old.id = old.token = '';
+    }
+    gesture = null;
+    $('sandbox-id').value = $('traffic-token').value = $('text').value = '';
+    $('controls').disabled = true;
+    $('disconnect').disabled = true;
+    screen.setAttribute('aria-disabled', 'true');
+    ctx.clearRect(0, 0, 720, 1280);
+    $('input-status').textContent = '';
+    $('status').textContent = message;
+  }
+
+  function failed(s) {
+    if (session === s) disconnect('已断开：请求失败。请检查沙箱、流量令牌、网络及代理 CORS 配置后重新连接。');
+  }
+
+  // All bridge requests share this header and cancellation boundary.
+  async function request(s, path, action, timeout = 10000) {
+    if (session !== s) throw new Error('Disconnected');
+    const controller = new AbortController();
+    const abort = () => controller.abort();
+    s.controller.signal.addEventListener('abort', abort, { once: true });
+    const deadline = setTimeout(() => controller.abort(), timeout);
+    let bitmap;
+    try {
+      const headers = {
+        'E2B-Sandbox-Id': s.id,
+        'E2B-Sandbox-Port': '8080',
+        'e2b-traffic-access-token': s.token
+      };
+      if (action) headers['Content-Type'] = 'application/json';
+      let response;
+      try {
+        response = await fetch(proxyBase + path, {
+          method: action ? 'POST' : 'GET', headers,
+          body: action ? JSON.stringify(action) : undefined,
+          signal: controller.signal, cache: 'no-store', credentials: 'omit',
+          redirect: 'error', referrerPolicy: 'no-referrer'
+        });
+      } catch {
+        const error = new Error('Bridge network request failed');
+        error.transient = true;
+        throw error;
+      }
+      if (!response.ok) {
+        const error = new Error('Bridge request failed');
+        error.status = response.status;
+        throw error;
+      }
+      if (path === '/screen') {
+        const blob = await response.blob();
+        if (blob.type !== 'image/png') throw new Error('Expected PNG');
+        bitmap = await createImageBitmap(blob);
+        if (bitmap.width !== 720 || bitmap.height !== 1280) throw new Error('Unexpected screen size');
+      } else if (path === '/health') {
+        const health = await response.json();
+        if (health.ready !== true || health.width !== 720 || health.height !== 1280) throw new Error('Android not ready');
+      } else {
+        await response.arrayBuffer();
+      }
+      if (session !== s) throw new Error('Disconnected');
+      if (controller.signal.aborted) throw new DOMException('Request timed out', 'AbortError');
+      return bitmap;
+    } catch (error) {
+      if (bitmap) bitmap.close();
+      throw error;
+    } finally {
+      clearTimeout(deadline);
+      s.controller.signal.removeEventListener('abort', abort);
+    }
+  }
+
+  function transient(error, s) {
+    if (session !== s || s.controller.signal.aborted) return false;
+    return error.transient === true || error.name === 'AbortError' || [408, 425, 429, 500, 502, 503, 504].includes(error.status);
+  }
+
+  function setRecovering(s) {
+    if (session !== s) return;
+    s.recovering = true;
+    $('controls').disabled = true;
+    screen.setAttribute('aria-disabled', 'true');
+    $('status').textContent = '正在恢复连接…';
+  }
+
+  function wait(s, milliseconds) {
+    return new Promise((resolve, reject) => {
+      if (session !== s) {
+        reject(new Error('Disconnected'));
+        return;
+      }
+      const timer = setTimeout(done, milliseconds);
+      const abort = () => {
+        clearTimeout(timer);
+        s.controller.signal.removeEventListener('abort', abort);
+        reject(new Error('Disconnected'));
+      };
+      function done() {
+        s.controller.signal.removeEventListener('abort', abort);
+        resolve();
+      }
+      s.controller.signal.addEventListener('abort', abort, { once: true });
+    });
+  }
+
+  async function recover(s, path) {
+    const deadline = Date.now() + RECOVERY_WINDOW;
+    let attempt = 0;
+    while (Date.now() < deadline) {
+      try {
+        return await request(s, path, undefined, Math.min(10000, deadline - Date.now()));
+      } catch (error) {
+        if (!transient(error, s) || Date.now() >= deadline) throw error;
+        setRecovering(s);
+        const delay = Math.min(RETRY_DELAYS[attempt++] || RETRY_DELAYS[RETRY_DELAYS.length - 1], deadline - Date.now());
+        await wait(s, Math.max(0, delay));
+      }
+    }
+    throw new Error('Recovery timed out');
+  }
+
+  async function poll(s) {
+    try {
+      const bitmap = await recover(s, '/screen');
+      try {
+        if (session !== s) return;
+        ctx.drawImage(bitmap, 0, 0);
+      } finally {
+        bitmap.close();
+      }
+      s.ready = true;
+      s.recovering = false;
+      $('controls').disabled = s.busy;
+      screen.setAttribute('aria-disabled', String(s.busy));
+      $('status').textContent = '已连接';
+      // Schedule only after fetching and decoding the previous frame.
+      s.poll = setTimeout(() => { if (session === s) void poll(s); }, 500);
+    } catch {
+      failed(s);
+    }
+  }
+
+  async function connect(id, token) {
+    disconnect();
+    if (typeof id !== 'string' || typeof token !== 'string' ||
+        !/^[A-Za-z0-9_-]{1,128}$/.test(id) || !/^[\x21-\x7e]{1,4096}$/.test(token)) {
+      $('status').textContent = '未连接：请填写有效的 Sandbox ID 和流量访问令牌。';
+      return;
+    }
+    const s = { id, token, controller: new AbortController(), ready: false, busy: false, recovering: false, poll: null };
+    session = s;
+    $('disconnect').disabled = false;
+    $('status').textContent = '正在连接…';
+    try {
+      await recover(s, '/health');
+      if (session === s) void poll(s);
+    } catch {
+      failed(s);
+    }
+  }
+  $('connect-form').addEventListener('submit', event => {
+    event.preventDefault();
+    void connect($('sandbox-id').value.trim(), $('traffic-token').value);
+  });
+  window.addEventListener('message', event => {
+    if (!window.opener || event.source !== window.opener || event.origin !== location.origin ||
+        event.data?.type !== 'android-screen-connect') return;
+    void connect(event.data.sandboxId, event.data.trafficAccessToken);
+  });
+  $('disconnect').addEventListener('click', () => disconnect());
+  window.addEventListener('pagehide', () => disconnect());
+  window.addEventListener('pageshow', () => {
+    disconnect();
+    if (window.opener) window.opener.postMessage({ type: 'android-screen-ready' }, location.origin);
+  });
+
+  async function send(action) {
+    const s = session;
+    if (!s || !s.ready || s.busy || s.recovering) return;
+    s.busy = true;
+    gesture = null;
+    $('controls').disabled = true;
+    screen.setAttribute('aria-disabled', 'true');
+    $('input-status').textContent = '正在发送…';
+    try {
+      await request(s, '/input', action);
+      if (session === s) $('input-status').textContent = '已发送';
+    } catch {
+      failed(s);
+    } finally {
+      if (session === s) {
+        s.busy = false;
+        $('controls').disabled = s.recovering;
+        screen.setAttribute('aria-disabled', String(s.recovering));
+      }
+    }
+  }
+
+  screen.addEventListener('keydown', event => {
+    if (document.activeElement !== screen || !session?.ready || session.busy || session.recovering || event.repeat ||
+        event.ctrlKey || event.altKey || event.metaKey || event.shiftKey || event.isComposing) return;
+    const key = new Map([
+      ['Backspace', 'DEL'], ['Delete', 'DEL'], ['Enter', 'ENTER'], ['Escape', 'BACK'],
+      ['Home', 'HOME'], ['ArrowUp', 'DPAD_UP'], ['ArrowDown', 'DPAD_DOWN'],
+      ['ArrowLeft', 'DPAD_LEFT'], ['ArrowRight', 'DPAD_RIGHT']
+    ]).get(event.key);
+    if (!key) return;
+    event.preventDefault();
+    void send({ action: 'key', key });
+  });
+
+  $('keys').addEventListener('click', event => {
+    const button = event.target.closest('button[data-key]');
+    if (button) void send({ action: 'key', key: button.dataset.key });
+  });
+  $('text-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const text = $('text').value;
+    if (!/^[\x20-\x7e]{1,256}$/.test(text) || text.includes('%s')) {
+      $('input-status').textContent = '未发送：仅支持 1–256 个可打印 ASCII 字符；不支持中文、其他非 ASCII 字符、换行或字面组合 %s（Android 空格转义）。';
+      return;
+    }
+    $('text').value = '';
+    void send({ action: 'text', text });
+  });
+  $('coordinates').addEventListener('submit', event => {
+    event.preventDefault();
+    if (!event.currentTarget.reportValidity()) return;
+    const x1 = $('x1').valueAsNumber, y1 = $('y1').valueAsNumber;
+    if (event.submitter?.value === 'swipe') {
+      void send({ action: 'swipe', x1, y1, x2: $('x2').valueAsNumber, y2: $('y2').valueAsNumber, duration: $('duration').valueAsNumber });
+    } else {
+      void send({ action: 'tap', x: x1, y: y1 });
+    }
+  });
+
+  function point(event) {
+    const rect = screen.getBoundingClientRect();
+    return {
+      x: Math.max(0, Math.min(719, Math.floor((event.clientX - rect.left) * 720 / rect.width))),
+      y: Math.max(0, Math.min(1279, Math.floor((event.clientY - rect.top) * 1280 / rect.height)))
+    };
+  }
+  screen.addEventListener('pointerdown', event => {
+    if (!session?.ready || session.busy || session.recovering || gesture || !event.isPrimary || event.button !== 0) return;
+    event.preventDefault();
+    screen.focus({ preventScroll: true });
+    gesture = { ...point(event), time: performance.now(), pointer: event.pointerId, session };
+    screen.setPointerCapture(event.pointerId);
+  });
+  screen.addEventListener('pointerup', event => {
+    const start = gesture;
+    if (!start || start.pointer !== event.pointerId) return;
+    gesture = null;
+    if (screen.hasPointerCapture(event.pointerId)) screen.releasePointerCapture(event.pointerId);
+    if (start.session !== session) return;
+    const end = point(event);
+    if (Math.hypot(end.x - start.x, end.y - start.y) < 10) {
+      void send({ action: 'tap', x: end.x, y: end.y });
+    } else {
+      const duration = Math.max(50, Math.min(2000, Math.round(performance.now() - start.time)));
+      void send({ action: 'swipe', x1: start.x, y1: start.y, x2: end.x, y2: end.y, duration });
+    }
+  });
+  for (const type of ['pointercancel', 'lostpointercapture']) {
+    screen.addEventListener(type, () => { gesture = null; });
+  }
+})();
+</script>
+</body>
+</html>
diff --git a/templates/android/build-android.mjs b/templates/android/build-android.mjs
new file mode 100644
index 0000000..bde3fc7
--- /dev/null
+++ b/templates/android/build-android.mjs
@@ -0,0 +1,48 @@
+import { Template, defaultBuildLogger } from 'e2b'
+
+function required(name) {
+  const value = process.env[name]
+  if (!value) throw new Error(`${name} is required`)
+  return value
+}
+
+function shellQuote(value) {
+  return `'${value.replaceAll("'", "'\"'\"'")}'`
+}
+
+function publicUrl(name) {
+  const value = required(name)
+  const url = new URL(value)
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+    throw new Error(`${name} must be an HTTP(S) URL without credentials`)
+  }
+  return value
+}
+
+const setupUrl = publicUrl('ANDROID_SETUP_URL')
+const artifactBaseUrl = publicUrl('ANDROID_ARTIFACT_BASE_URL').replace(/\/+$/, '')
+const redroidArchiveUrl = publicUrl('ANDROID_REDROID_IMAGE_ARCHIVE_URL')
+const setupSha256 = required('ANDROID_SETUP_SHA256')
+if (!/^[a-f0-9]{64}$/i.test(setupSha256)) throw new Error('ANDROID_SETUP_SHA256 must be a SHA-256 digest')
+
+const templateName = process.env.ANDROID_TEMPLATE_NAME || 'android-16'
+const cpuCount = Number(process.env.ANDROID_CPU_COUNT || 8)
+const memoryMB = Number(process.env.ANDROID_MEMORY_MB || 4096)
+if (!Number.isInteger(cpuCount) || cpuCount < 1 || !Number.isInteger(memoryMB) || memoryMB < 1024) {
+  throw new Error('ANDROID_CPU_COUNT and ANDROID_MEMORY_MB must be valid positive integers')
+}
+
+const template = Template().fromBaseImage()
+  .runCmd([
+    `curl --fail --location --connect-timeout 10 --max-time 60 --proto '=http,https' ${shellQuote(setupUrl)} -o /tmp/setup-android-guest.sh`,
+    `printf '%s  %s\\n' ${shellQuote(setupSha256)} /tmp/setup-android-guest.sh | sha256sum -c -`,
+    `ANDROID_ARTIFACT_BASE_URL=${shellQuote(artifactBaseUrl)} ANDROID_REDROID_IMAGE_ARCHIVE_URL=${shellQuote(redroidArchiveUrl)} bash /tmp/setup-android-guest.sh`,
+  ].join(' && '), { user: 'root' })
+  .setStartCmd('sudo -n /opt/android/start-android.sh', 'curl --fail --max-time 10 http://127.0.0.1:8080/health')
+
+await Template.build(template, templateName, {
+  cpuCount,
+  memoryMB,
+  onBuildLogs: defaultBuildLogger(),
+})
+console.log('ANDROID_TEMPLATE_BUILD_COMPLETE')
