diff --git a/templates/android/kernel-input/build-kernel.sh b/templates/android/kernel-input/build-kernel.sh
new file mode 100755
index 0000000..9f4f468
--- /dev/null
+++ b/templates/android/kernel-input/build-kernel.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -euo pipefail
+if (( $# != 1 )); then
+    printf 'Usage: bash %s /path/to/linux-c2b7f640ec01cb093c6ba9e08b7ebcb400741bb4.tar.gz\n' "$0" >&2
+    exit 2
+fi
+archive=$1
+input=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
+root=$(dirname -- "$input")
+src=$root/kernel-source
+build=$root/kernel-build
+out=$root/kernel-output
+# Never reuse or overwrite a previous (possibly partial) build.
+for path in "$src" "$build" "$out"; do
+    if [[ -e "$path" || -L "$path" ]]; then
+        printf 'Refusing existing path: %s; move it aside before rebuilding.\n' "$path" >&2
+        exit 1
+    fi
+done
+python3 "$input/verify-kernel.py" --inputs-only --require-archive --archive "$archive"
+for tool in gcc g++ make bc ld objcopy readelf bison flex pahole patch tar gzip perl openssl; do
+    command -v "$tool" >/dev/null || { printf 'Missing build dependency: %s\n' "$tool" >&2; exit 1; }
+done
+[[ $(uname -m) == x86_64 ]] || { printf 'Build requires an x86_64 Linux host.\n' >&2; exit 1; }
+mkdir "$src" "$build" "$out"
+mkdir "$out/tmp"
+export TMPDIR="$out/tmp"
+export KBUILD_BUILD_USER=android-template KBUILD_BUILD_HOST=android-template
+export KBUILD_BUILD_TIMESTAMP='Fri Nov 6 18:00:00 UTC 2026' KBUILD_BUILD_VERSION=1
+exec > >(tee -a "$out/build.log") 2>&1
+trap 'rc=$?; printf "%s\n" "$rc" > "$out/build.exit"' EXIT
+printf 'Build started: '; date -u --iso-8601=seconds
+tar -xzf "$archive" --strip-components=1 -C "$src"
+for patch_name in 0001-virtio_balloon-Support-wait-on-ACK-for-hinting.patch 0001-memfd-answer-ashmem-ioctls.patch; do
+    patch -d "$src" -p1 --batch --fuzz=0 --dry-run < "$input/$patch_name"
+    patch -d "$src" -p1 --batch --fuzz=0 < "$input/$patch_name"
+done
+cp "$input/6.1.158-android.config" "$build/.config"
+make -C "$src" O="$build" ARCH=x86_64 olddefconfig
+cp "$build/.config" "$out/kernel.config"
+python3 "$input/verify-kernel.py" --config-only --archive "$archive"
+make -C "$src" O="$build" ARCH=x86_64 -j8 vmlinux
+objcopy --only-keep-debug "$build/vmlinux" "$out/vmlinux.debug"
+objcopy --strip-debug "$build/vmlinux" "$out/vmlinux.bin"
+cp "$build/System.map" "$out/System.map"
+python3 "$input/verify-kernel.py" --archive "$archive"
+printf 'Build finished: '; date -u --iso-8601=seconds
