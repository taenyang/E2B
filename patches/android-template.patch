+#!/usr/bin/env bash
+set -euo pipefail
+export DEBIAN_FRONTEND=noninteractive
+
+: "${ANDROID_ARTIFACT_BASE_URL:?set ANDROID_ARTIFACT_BASE_URL to the reviewed Android artifact server}"
+: "${ANDROID_REDROID_IMAGE_ARCHIVE_URL:?set ANDROID_REDROID_IMAGE_ARCHIVE_URL to the separately prepared redroid image archive}"
+ANDROID_ARTIFACT_BASE_URL=${ANDROID_ARTIFACT_BASE_URL%/}
+ANDROID_REDROID_IMAGE=${ANDROID_REDROID_IMAGE:-redroid/redroid:16.0.0_64only-latest}
+
+apt-get update -qq
+apt-get install -y --no-install-recommends docker.io adb ca-certificates curl python3
+systemctl start docker
+curl --fail --location --connect-timeout 10 --max-time 600 "$ANDROID_REDROID_IMAGE_ARCHIVE_URL" | docker load
+install -d /opt/android/data
+curl --fail --location --connect-timeout 10 --max-time 60 "$ANDROID_ARTIFACT_BASE_URL/start-android.sh" -o /opt/android/start-android.sh
+curl --fail --location --connect-timeout 10 --max-time 60 "$ANDROID_ARTIFACT_BASE_URL/android-screen-bridge.py" -o /opt/android/android-screen-bridge.py
+chown root:root /opt/android/start-android.sh /opt/android/android-screen-bridge.py
+chmod 755 /opt/android/start-android.sh /opt/android/android-screen-bridge.py
+cat > /etc/systemd/system/android-screen-bridge.service <<'EOF'
+[Unit]
+Description=Private Android screen bridge
+After=docker.service
+Requires=docker.service
+
+[Service]
+ExecStart=/usr/bin/python3 /opt/android/android-screen-bridge.py
+Restart=on-failure
+RestartSec=2
+UMask=0077
+
+[Install]
+WantedBy=multi-user.target
+EOF
+systemctl daemon-reload
+# Keep ADB on the guest loopback interface; the client-proxy supplies access control.
+docker create --name android --privileged --restart unless-stopped \
+  -p 127.0.0.1:5555:5555 -v /opt/android/data:/data --shm-size 1g \
+  "$ANDROID_REDROID_IMAGE" \
+  androidboot.redroid_width=720 androidboot.redroid_height=1280 \
+  androidboot.redroid_dpi=320 androidboot.redroid_gpu_mode=guest androidboot.use_memfd=true
+apt-get clean
