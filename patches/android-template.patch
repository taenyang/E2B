+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+: "${E2B_EMBED_DIR:?set E2B_EMBED_DIR to the Embed Compose project directory}"
+: "${E2B_API_KEY:?set E2B_API_KEY in the environment}"
+: "${ANDROID_SETUP_URL:?set ANDROID_SETUP_URL to the reviewed setup script URL}"
+: "${ANDROID_SETUP_SHA256:?set ANDROID_SETUP_SHA256 to the setup script digest}"
+: "${ANDROID_ARTIFACT_BASE_URL:?set ANDROID_ARTIFACT_BASE_URL to the reviewed Android artifact server}"
+: "${ANDROID_REDROID_IMAGE_ARCHIVE_URL:?set ANDROID_REDROID_IMAGE_ARCHIVE_URL to the separately prepared redroid image archive}"
+: "${ANDROID_KERNEL_OUTPUT:?set ANDROID_KERNEL_OUTPUT to the separately built custom kernel output directory}"
+ANDROID_KERNEL_VERSION=${ANDROID_KERNEL_VERSION:-6.1.158-android-lab1}
+
+install -d "/fc-kernels/vmlinux-$ANDROID_KERNEL_VERSION/amd64"
+install -m 644 "$ANDROID_KERNEL_OUTPUT/vmlinux.bin" "/fc-kernels/vmlinux-$ANDROID_KERNEL_VERSION/amd64/vmlinux.bin"
+sha256sum "/fc-kernels/vmlinux-$ANDROID_KERNEL_VERSION/amd64/vmlinux.bin"
+
+docker compose --project-directory "$E2B_EMBED_DIR" run --rm --no-deps \
+  -e E2B_API_KEY -e ANDROID_SETUP_URL -e ANDROID_SETUP_SHA256 \
+  -e ANDROID_ARTIFACT_BASE_URL -e ANDROID_REDROID_IMAGE_ARCHIVE_URL \
+  -e ANDROID_TEMPLATE_NAME -e ANDROID_CPU_COUNT -e ANDROID_MEMORY_MB \
+  -v "$ROOT/build-android.mjs:/app/build-android.mjs:ro" \
+  base-template node /app/build-android.mjs
