+
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+: "${E2B_EMBED_DIR:?set E2B_EMBED_DIR to the Embed Compose project directory}"
+: "${E2B_API_KEY:?set E2B_API_KEY in the environment}"
+: "${E2B_API_URL:?set E2B_API_URL for online verification}"
+: "${E2B_SANDBOX_URL:?set E2B_SANDBOX_URL for online verification}"
+: "${DASHBOARD_URL:?set DASHBOARD_URL for browser verification}"
+: "${CORS_ORIGIN:?set CORS_ORIGIN to the Dashboard origin}"
+: "${PLAYWRIGHT_MODULE:?set PLAYWRIGHT_MODULE to the installed Playwright module}"
+
